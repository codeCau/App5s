@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold" href="">App 5S</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Início
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <!-- Links visíveis apenas para quem está autenticado -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="auditorias">
                        <span class="bi bi-clipboard-check-nav-menu" aria-hidden="true"></span> Auditorias 5S
                    </NavLink>
                </div>

                <!-- Painel com dados do usuário logado e logout -->
                <div class="mt-4 px-3 py-3 mx-2 rounded bg-dark border border-secondary text-white">
                    <small class="d-block text-secondary" style="font-size: 0.75rem;">CONECTADO COMO</small>
                    <div class="fw-bold text-truncate" title="@context.User.Identity?.Name">
                        @context.User.Identity?.Name
                    </div>
                    <span class="badge bg-primary mt-1">
                        @context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                    </span>

                    <div class="mt-3">
                        <a href="/api/auth/logout" class="btn btn-outline-danger btn-sm w-100">
                            Sair da Conta
                        </a>
                    </div>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="mt-4 px-3">
                    <a href="/login" class="btn btn-primary btn-sm w-100">
                        Entrar no Sistema
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}