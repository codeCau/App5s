@page "/login"
@using App5s.Data
@using Microsoft.EntityFrameworkCore
@inject AppDbContext Db
@inject NavigationManager NavigationManager

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light px-3">
    <div class="card border-0 shadow-sm rounded-4 w-100" style="max-width: 420px;">
        <div class="card-body p-4 p-sm-5">
            
            <!-- Cabeçalho / Logo -->
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3" style="width: 56px; height: 56px;">
                    <i class="bi bi-shield-check fs-2"></i>
                </div>
                <h4 class="fw-bold mb-1 text-dark">App 5S</h4>
                <p class="text-secondary small mb-0">Auditoria e Qualidade Operacional</p>
            </div>

            <!-- Alerta de Erro -->
            @if (TemErro)
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 rounded-3 small border-0 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                    <div>E-mail ou senha incorretos. Tente novamente.</div>
                </div>
            }

            <!-- Formulário de Acesso -->
<form method="post" action="/auth/login">
    <div class="mb-3">
        <label class="form-label small fw-semibold text-secondary">E-mail corporativo</label>
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0 text-muted">
                <i class="bi bi-envelope"></i>
            </span>
            <input type="email" name="email" class="form-control border-start-0 ps-0" 
                   placeholder="nome@empresa.com" autocomplete="username" required />
        </div>
    </div>

    <div class="mb-4">
        <label class="form-label small fw-semibold text-secondary">Senha</label>
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0 text-muted">
                <i class="bi bi-lock"></i>
            </span>
            <input type="password" name="senha" class="form-control border-start-0 ps-0" 
                   placeholder="••••••••" autocomplete="current-password" required />
        </div>
    </div>

    <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-semibold shadow-sm">
        Acessar Plataforma
    </button>
</form>

            <div class="text-center mt-4 pt-2 border-top">
                <span class="text-muted" style="font-size: 0.75rem;">Sistema de Auditoria 5S • Versão 1.0</span>
            </div>

        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private bool? Error { get; set; }

    private bool TemErro => Error == true;

    protected override async Task OnInitializedAsync()
    {
        var existeUsuarios = await Db.Usuarios.AnyAsync();
        if (!existeUsuarios)
        {
            NavigationManager.NavigateTo("/setup");
        }
    }
}