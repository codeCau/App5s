@page "/setup"
@rendermode InteractiveServer
@using App5s.Data
@using App5s.Models
@using App5s.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthService AuthService
@inject LogService LogService
@inject NavigationManager NavigationManager

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light px-3 py-5">
    <div class="card border-0 shadow-sm rounded-4 w-100" style="max-width: 480px;">
        <div class="card-body p-4 p-sm-5">
            
            <!-- Cabeçalho Setup -->
            <div class="text-center mb-4">
                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-1 rounded-pill small fw-medium mb-3">
                    <i class="bi bi-gear-fill me-1"></i> Primeiro Acesso
                </span>
                <h4 class="fw-bold mb-1 text-dark">Configuração Inicial</h4>
                <p class="text-secondary small mb-0">Cadastre a conta de Administrador principal do sistema</p>
            </div>

            <!-- Avisos e Mensagens -->
            @if (!string.IsNullOrEmpty(mensagemErro))
            {
                <div class="alert alert-danger d-flex align-items-center gap-2 py-2 px-3 rounded-3 small border-0 mb-4" role="alert">
                    <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
                    <div>@mensagemErro</div>
                </div>
            }

            <EditForm Model="@modelo" OnValidSubmit="CadastrarAdminInicial">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Nome Completo</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-person"></i>
                        </span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Ex: Administrador do Sistema" 
                               @bind="modelo.Nome" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">E-mail Principal</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input type="email" class="form-control border-start-0 ps-0" placeholder="admin@app5s.local" 
                               @bind="modelo.Email" required />
                    </div>
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold text-secondary">Senha</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-key"></i>
                            </span>
                            <input type="password" class="form-control border-start-0 ps-0" placeholder="Mínimo 6 dígitos" 
                                   @bind="modelo.Senha" required />
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label small fw-semibold text-secondary">Confirmar Senha</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-check2-circle"></i>
                            </span>
                            <input type="password" class="form-control border-start-0 ps-0" placeholder="Repita a senha" 
                                   @bind="modelo.ConfirmarSenha" required />
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-success w-100 py-2 rounded-3 fw-semibold shadow-sm" disabled="@processando">
                    @if (processando)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Criando credenciais...</span>
                    }
                    else
                    {
                        <span><i class="bi bi-check-lg me-1"></i> Finalizar Instalação</span>
                    }
                </button>
            </EditForm>

        </div>
    </div>
</div>

@code {
    private SetupModel modelo = new();
    private string? mensagemErro;
    private bool processando;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Usuarios.AnyAsync())
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    private async Task CadastrarAdminInicial()
    {
        if (modelo.Senha != modelo.ConfirmarSenha)
        {
            mensagemErro = "As senhas informadas não coincidem.";
            return;
        }

        if (modelo.Senha.Length < 6)
        {
            mensagemErro = "A senha deve conter pelo menos 6 caracteres.";
            return;
        }

        processando = true;
        mensagemErro = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var admin = new Usuario
            {
                Nome = modelo.Nome.Trim(),
                Email = modelo.Email.Trim().ToLowerInvariant(),
                SenhaHash = AuthService.GerarHashSenha(modelo.Senha),
                Perfil = "Admin",
                Ativo = true,
                CriadoEm = DateTime.UtcNow
            };

            db.Usuarios.Add(admin);
            await db.SaveChangesAsync();

            await LogService.RegistrarAsync(
                "INFO", 
                "Administrador inicial provisionado com sucesso via /setup", 
                origem: "Setup", 
                usuarioEmail: admin.Email
            );

            NavigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao registrar administrador: {ex.Message}";
        }
        finally
        {
            processando = false;
        }
    }

    public class SetupModel
    {
        public string Nome { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Senha { get; set; } = string.Empty;
        public string ConfirmarSenha { get; set; } = string.Empty;
    }
}